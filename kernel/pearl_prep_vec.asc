#include "acl/acl.h"
#include "kernel_operator.h"
/* Correctness-first gather implementation: indices/EAL stay in UB per row.
 * Vector Add/Sub perform the bulk arithmetic. Scalar narrowing explicitly
 * wraps mod 256; Ascend Cast alone would saturate and change proof semantics. */
__global__ __vector__ void pearl_make_an(__gm__ int8_t *a,__gm__ int8_t *eal,
 __gm__ uint16_t *first,__gm__ uint16_t *second,__gm__ int8_t *an,
 uint32_t m,uint32_t k,uint32_t rank){
 AscendC::TPipe pipe;
 AscendC::TBuf<AscendC::TPosition::VECCALC> ab,fb,sb,ob,eb,ib,jb,db;
 pipe.InitBuffer(ab,512);pipe.InitBuffer(fb,512);pipe.InitBuffer(sb,512);pipe.InitBuffer(ob,512);
 pipe.InitBuffer(eb,rank);pipe.InitBuffer(ib,k*2);pipe.InitBuffer(jb,k*2);pipe.InitBuffer(db,256);
 auto av=ab.Get<int16_t>(),fv=fb.Get<int16_t>(),sv=sb.Get<int16_t>(),ov=ob.Get<int16_t>();
 auto ev=eb.Get<int8_t>();auto fi=ib.Get<uint16_t>(),si=jb.Get<uint16_t>();auto dst=db.Get<int8_t>();
 AscendC::GlobalTensor<int8_t> ag,eg,og;ag.SetGlobalBuffer(a);eg.SetGlobalBuffer(eal);og.SetGlobalBuffer(an);
 AscendC::GlobalTensor<uint16_t> fg,sg;fg.SetGlobalBuffer(first);sg.SetGlobalBuffer(second);
 AscendC::DataCopy(fi,fg,k);AscendC::DataCopy(si,sg,k);AscendC::PipeBarrier<PIPE_ALL>();
 for(uint32_t row=AscendC::GetBlockIdx();row<m;row+=AscendC::GetBlockNum()){
  AscendC::DataCopy(ev,eg[(uint64_t)row*rank],rank);AscendC::PipeBarrier<PIPE_ALL>();
  for(uint32_t col=0;col<k;col+=256){
   for(uint32_t j=0;j<256;j++){
    av.SetValue(j,ag.GetValue((uint64_t)row*k+col+j));
    fv.SetValue(j,ev.GetValue(fi.GetValue(col+j)));sv.SetValue(j,ev.GetValue(si.GetValue(col+j)));
   }
   AscendC::PipeBarrier<PIPE_ALL>();
   AscendC::Add(ov,av,fv,256);AscendC::PipeBarrier<PIPE_V>();
   AscendC::Sub(ov,ov,sv,256);AscendC::PipeBarrier<PIPE_ALL>();
   for(uint32_t j=0;j<256;j++){int v=ov.GetValue(j);if(v>127)v-=256;if(v< -128)v+=256;ov.SetValue(j,(int16_t)v);}
   AscendC::PipeBarrier<PIPE_ALL>();
   AscendC::Cast(dst,ov,AscendC::RoundMode::CAST_NONE,256);AscendC::PipeBarrier<PIPE_ALL>();
   AscendC::DataCopy(og[(uint64_t)row*k+col],dst,256);AscendC::PipeBarrier<PIPE_ALL>();
  }
 }
}
extern "C" void LaunchPrepVec(int8_t *a,int8_t *e,uint16_t *f,uint16_t *s,int8_t *an,
 uint32_t m,uint32_t k,uint32_t rank,void *stream){
 pearl_make_an<<<8,nullptr,stream>>>(a,e,f,s,an,m,k,rank);
}
