#include "aicpu_api.h"
#include "a_prep/args.h"
#include "a_prep/blake3_scalar.h"
static uint64_t splitmix(uint64_t &x){uint64_t z=(x+=0x9e3779b97f4a7c15ULL);z=(z^(z>>30))*0xbf58476d1ce4e5b9ULL;z=(z^(z>>27))*0x94d049bb133111ebULL;return z^(z>>31);}
static uint64_t rot(uint64_t x,int k){return x<<k|x>>(64-k);}
static uint64_t next(uint64_t *s){uint64_t r=rot(s[1]*5,7)*9,t=s[1]<<17;s[2]^=s[0];s[3]^=s[1];s[1]^=s[2];s[0]^=s[3];s[2]^=t;s[3]=rot(s[3],45);return r;}
static void draw(uint32_t i,const uint8_t *key,int slot,uint8_t *d){
 uint8_t msg[64]={};uint32_t v=i+1;for(int j=0;j<4;j++)msg[slot*4+j]=(uint8_t)(v>>(8*j));
 memcpy(msg+32,"A_tensor",8);pearl_b3::hash(msg,64,key,d);
}
__global__ __aicpu__ uint32_t pearl_prep_a(void *arg){
 const PearlPrepArgs &p=*(const PearlPrepArgs*)arg;const uint64_t total=p.m*p.k;
 if(p.random_fill){
  for(unsigned t=0;t<p.threads;t++){
   uint64_t x=p.seed+0x9e37ULL*(t+1),s[4];for(int j=0;j<4;j++)s[j]=splitmix(x);
   uint64_t i=total*t/p.threads,hi=total*(t+1)/p.threads;
   while(i<hi){uint64_t v=next(s);for(int j=0;j<8 && i<hi;j++,v>>=8)p.a[i++]=(int8_t)((uint8_t)v%127)-63;}
  }
 }else{memset(p.a,0,total);for(int i=0;i<8;i++)p.a[i]=(int8_t)(p.seed>>(8*i));}
 pearl_b3::hash((const uint8_t*)p.a,total,p.key,p.roots);
 static const uint8_t salt[32]={0x82,0x49,0x40,0x6c,0xa0,0xed,0x15,0x16,0x96,0x16,0xf6,0x92,0xfc,0xf0,0x76,0xf8,0x92,0xdb,0xdb,0x2a,0x70,0x23,0xb8,0x52,0xf0,0xd4,0x77,0x19,0xc3,0x90,0x01,0x7b};
 uint8_t salted[32],msg[64]={};memcpy(salted,p.roots,32);
 if(p.cert>=3){memcpy(msg,p.roots,32);for(int j=0;j<4;j++)msg[32+j]=(uint8_t)(p.m>>(8*j));pearl_b3::hash(msg,64,salt,salted);}
 memcpy(msg,p.commit_b,32);memcpy(msg+32,salted,32);pearl_b3::hash(msg,64,nullptr,p.roots+32);
 for(uint64_t i=0;i<(p.m*p.rank+31)/32;i++){uint8_t d[32];draw((uint32_t)i,p.roots+32,0,d);for(unsigned j=0;j<32 && i*32+j<p.m*p.rank;j++)p.eal[i*32+j]=(int8_t)((d[j]&63)-32);}
 for(uint64_t i=0;i<(p.k+7)/8;i++){uint8_t d[32];draw((uint32_t)i,p.roots+32,1,d);for(unsigned j=0;j<8 && i*8+j<p.k;j++){uint32_t u=pearl_b3::load(d+4*j),f=u&(p.rank-1);p.first[i*8+j]=(uint16_t)f;p.second[i*8+j]=(uint16_t)(f^(1u+(uint32_t)(((uint64_t)(p.rank-1)*u)>>32)));}}
 return 0;
}
